{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "EurekaLife 录音": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EurekaLife 录音"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EurekaLife Recording"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EurekaLife 録音"
          }
        }
      }
    },
    "轻点开始录音；录音中轻点返回，停止并保存请使用 App 内按钮。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点开始录音；录音中轻点返回，停止并保存请使用 App 内按钮。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to start recording, or return to an ongoing recording. Stop and save in the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして録音を開始、または録音中のアプリに戻ります。停止と保存はアプリ内で行います。"
          }
        }
      }
    },
    "EurekaLife 快捷录音": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EurekaLife 快捷录音"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EurekaLife Quick Recording"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EurekaLife クイック録音"
          }
        }
      }
    },
    "未录音时开始录音，录音中返回 App。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未录音时开始录音，录音中返回 App。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a recording, or return to the app if already recording."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を開始します。録音中の場合はアプリに戻ります。"
          }
        }
      }
    },
